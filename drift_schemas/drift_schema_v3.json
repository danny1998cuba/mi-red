    {
      "id": 11,
      "references": [
        8,
        5
      ],
      "type": "trigger",
      "data": {
        "on": 8,
        "references_in_body": [
          8,
          5
        ],
        "name": "payments_exact_amount",
        "sql": "CREATE TRIGGER payments_exact_amount BEFORE INSERT ON payments\nWHEN NEW.voided_at IS NULL\n  AND NOT EXISTS (SELECT 1 FROM charges WHERE id = NEW.charge_id AND amount_minor = NEW.amount_minor)\nBEGIN\n  SELECT RAISE(ABORT, 'El importe debe coincidir con un cargo existente.');\nEND;"
      }
    },
    {
      "id": 12,
      "references": [
        8
      ],
      "type": "trigger",
      "data": {
        "on": 8,
        "references_in_body": [
          8
        ],
        "name": "payments_immutable",
        "sql": "CREATE TRIGGER payments_immutable BEFORE UPDATE ON payments\nWHEN NEW.id IS NOT OLD.id OR NEW.charge_id IS NOT OLD.charge_id\n  OR NEW.amount_minor IS NOT OLD.amount_minor OR NEW.paid_at IS NOT OLD.paid_at\n  OR NEW.note IS NOT OLD.note OR OLD.voided_at IS NOT NULL OR NEW.voided_at IS NULL\nBEGIN\n  SELECT RAISE(ABORT, 'El pago histórico solo puede anularse una vez.');\nEND;"
      }
    },
    {
      "id": 13,
      "references": [
        5,
        8
      ],
      "type": "trigger",
      "data": {
        "on": 5,
        "references_in_body": [
          5,
          8
        ],
        "name": "charges_preserve_paid_history",
        "sql": "CREATE TRIGGER charges_preserve_paid_history BEFORE UPDATE ON charges\nWHEN (EXISTS (SELECT 1 FROM payments WHERE charge_id = OLD.id)\n  AND (NEW.id IS NOT OLD.id OR NEW.client_id IS NOT OLD.client_id OR NEW.period_key IS NOT OLD.period_key))\n  OR (NEW.amount_minor IS NOT OLD.amount_minor\n    AND EXISTS (SELECT 1 FROM payments WHERE charge_id = OLD.id AND voided_at IS NULL))\nBEGIN\n  SELECT RAISE(ABORT, 'El cargo conserva su historial de pagos.');\nEND;"
      }
    },
