    {
      "name": "clients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clients\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(trim(id)) > 0), \"full_name\" TEXT NOT NULL CHECK (length(trim(full_name)) > 0), \"phone\" TEXT, \"address\" TEXT, \"monthly_fee_minor\" INTEGER NOT NULL CHECK (typeof(monthly_fee_minor) = 'integer' AND monthly_fee_minor >= 0), \"status\" TEXT NOT NULL CHECK (status IN ('active', 'suspended', 'archived')), \"notes\" TEXT, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"archived_at\" INTEGER, \"billing_start_period\" TEXT NOT NULL CHECK (billing_start_period GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]' AND substr(billing_start_period, 1, 4) >= '0001' AND substr(billing_start_period, 6, 2) BETWEEN '01' AND '12'), CHECK((status = 'archived')=(archived_at IS NOT NULL)));"
        }
      ]
    },
