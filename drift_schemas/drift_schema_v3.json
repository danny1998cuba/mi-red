          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"charges\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(trim(id)) > 0), \"client_id\" TEXT NOT NULL REFERENCES clients(id)ON DELETE RESTRICT, \"period_key\" TEXT NOT NULL CHECK (period_key GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]' AND substr(period_key, 1, 4) >= '0001' AND substr(period_key, 6, 2) BETWEEN '01' AND '12'), \"collection_date\" TEXT NOT NULL CHECK (collection_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND date(collection_date, '+0 days') IS NOT NULL AND date(collection_date, '+0 days') = collection_date), \"suspension_candidate_date\" TEXT NOT NULL CHECK (suspension_candidate_date = period_key || '-03'), \"amount_minor\" INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor >= 0), \"created_at\" INTEGER NOT NULL, UNIQUE(client_id, period_key));"
        }
      ]
